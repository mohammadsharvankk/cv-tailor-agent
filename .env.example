# Copy to .env and fill in. Never commit .env.

# anthropic | openai | mock   (mock = rule-based demo, no key needed)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Output limit per LLM call; raise it if you get a 'reply was cut off' error
MAX_OUTPUT_TOKENS=16000

# Independent reviewer + one guarded revision (+1-2 calls per run). Set false to save cost.
REVIEW_ENABLED=true

# OPENAI only, optional:
# TEMPERATURE=0.2

# Private master CV (git-ignored folder). Set false if you deploy for other people.
MASTER_CV_ENABLED=true
MASTER_CV_PATH=my_cv/master_cv.md
